---
import { markdownify } from "@/lib/utils/textConverter";
import FeatureAccordion from "@/components/FeatureAccordion";
const { call_to_action } = Astro.props;
---

{call_to_action?.data?.enable && (
  <section
    class="h-[900px] bg-cover bg-center relative"
    style={`background-image: url('${call_to_action.data.image || '/images/call-to-action.avif'}')`}
  >
    <div class="container">
      <div class="pt-12 px-10 pb-10 bg-light w-[560px] rounded-2xl absolute top-20">
        <div>
          <h1
            class="leading-15 tracking-[-2.5px] mb-4 text-4xl md:text-5xl font-bold"
            set:html={markdownify(call_to_action.data.title)}
          />
          <p
            class="mb-8 text-text-dark/80"
            set:html={markdownify(call_to_action.data.description)}
          />
          {call_to_action.data.button?.enable && (
            <a
              class="py-[10px] px-6 border-2 border-border rounded-full hover:bg-primary transition"
              href={call_to_action.data.button.link || "/"}
            >
              {call_to_action.data.button.label || "Get a Quote"}
            </a>
          )}
        </div>

        {/* FAQ Accordion for Features */}
        {call_to_action.data.features?.length > 0 && (
          <FeatureAccordion features={call_to_action.data.features} client:load />
        )}
      </div>
    </div>

    <div class="absolute bg-light h-20 w-full bottom-0 rounded-t-3xl"></div>
  </section>
)}
