---
import { MdKeyboardArrowDown } from "react-icons/md";
---

<section class="section-sm bg-secondary rounded-t-3xl mt-20 relative">
  <div class="container py-20 flex flex-col lg:flex-row items-start gap-10">
    <!-- Left side -->
    <aside class="text-center md:text-left max-w-[534px] mx-auto md:mx-0 text-text-light">
      <h2 class="text-5xl leading-[60px] mb-4 max-w-[70%] mx-auto md:mx-0">Let’s Find Your Perfect Property</h2>
      <p class="text-lg leading-8 text-text-light/70">
        Have questions or ready to take the next step? Whether you’re buying,
        selling, or just exploring options.
      </p>
      <div class="flex items-center gap-15 mt-[111px]">
        <div>
          <p class="text-text-light/70 mb-1">Email Address</p>
          <p>support@homequest.com</p>
        </div>
        <div>
          <p class="text-text-light/70 mb-1">Phone Call</p>
          <p>+0291801920, +982771882</p>
        </div>
      </div>
    </aside>

    <!-- Right side (Form) -->
    <form class="w-full lg:w-[650px] text-text-light flex flex-col gap-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <!-- Left Column -->
        <div class="space-y-8">
          <label for="name" class="block mb-1">Your name</label>
          <input type="text" id="name" placeholder="First and last name" class="custom-input" />

          <label for="location" class="block mt-4 mb-1">Your preferred location</label>
          <div class="relative">
            <select id="location" class="custom-input appearance-none pr-8 w-full">
              <option class="text-text-dark" value="">New York</option>
              <option class="text-text-dark" value="">Amsterdam</option>
              <option class="text-text-dark" value="">Barcelona</option>
            </select>
            <MdKeyboardArrowDown className="absolute right-2 top-1/2 -translate-y-1/2 text-lg text-gray-500 pointer-events-none" />
          </div>

          <label for="email" class="block mt-4 mb-1">Your email address</label>
          <input type="email" id="email" placeholder="youremail@gmail.com" class="custom-input" />
        </div>

        <!-- Right Column -->
        <div class="space-y-8">
          <label for="property" class="block mb-1">What do you want?</label>
          <div class="relative">
            <select id="property" class="custom-input appearance-none pr-8 w-full">
            <option value="" disabled selected>Buy a house</option>
            <option class="text-text-dark" value="Modern 3-Bedroom Apartment in Gulshan, Dhaka">Modern 3-Bedroom Apartment in Gulshan, Dhaka</option>
            <option class="text-text-dark" value="Luxury 4-Bedroom Villa in Downtown, Mumbai">Luxury 4-Bedroom Villa in Downtown, Mumbai</option>
            <option class="text-text-dark" value="Luxury 2-Bedroom Villa in Salt Lake, West Bengal">Luxury 2-Bedroom Villa in Salt Lake, West Bengal</option>
            <option class="text-text-dark" value="Chic 1-Bedroom Apartment in Kuala Lumpur, Malaysia">Chic 1-Bedroom Apartment in Kuala Lumpur, Malaysia</option>
            <option class="text-text-dark" value="Spacious 3-Bedroom Townhouse in Toronto, Canada">Spacious 3-Bedroom Townhouse in Toronto, Canada</option>
         </select>
            <MdKeyboardArrowDown className="absolute right-2 top-1/2 -translate-y-1/2 text-lg text-gray-500 pointer-events-none" />
          </div>

          <label for="budget" class="block mt-12 mb-1">Your budget</label>
          <input type="text" id="budget" placeholder="$100,000" class="custom-input" />
          <label for="phone" class="block mb-1">Your phone number</label>
          <input type="tel" id="phone" placeholder="016xxxxxxxx" class="custom-input" />
        </div>
      </div>
      <button type="submit" class="btn btn-primary mt-6 w-fit rounded-full cursor-pointer">
        Get a Quote
      </button>
    </form>
  </div>
   <div class="absolute bg-white h-20 w-full bottom-0 rounded-t-3xl"></div>
</section>