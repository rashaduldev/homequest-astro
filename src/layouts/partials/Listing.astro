---
import ImageMod from "@/components/ImageMod.astro";
import DynamicIcon from "@/helpers/DynamicIcon";
import { markdownify } from "@/lib/utils/textConverter";
const { listing } = Astro.props;
---

{
  listing.data.enable && (
    <section class="pt-30 pb-15 px-[30px]">
      <div class="container">
        <h2
          set:html={markdownify(listing.data.title)}
          class="mb-16 text-text-dark text-center text-5xl leading-15"
        />
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {listing.data.listing.map(
            (item: {
              title: string;
              pricing: string;
              month: string;
              sqfit: string;
              bed: number;
              bath: number;
              img: string;
              text: string;
            }) => (
              <a 
                href="/" 
                class="group text-text-dark pb-8 cursor-pointer relative overflow-hidden rounded-2xl"
              >
                <div class="overflow-hidden rounded-2xl">
                  <ImageMod
                    height={346}
                    width={500}
                    class="w-full h-[346px] object-cover transition-transform duration-500 ease-in-out group-hover:scale-105"
                    src={item.img}
                    alt={item.text}
                    format="webp"
                  />
                </div>

                <p class="py-1 px-3 bg-light absolute top-3 left-3 rounded-[10px] leading-7">{item.text}</p>
                
                <div class="mt-6 px-3">
                  <span class="text-text font-semibold">${item.pricing}</span>
                  <h5 class="text-text-dark mt-2 text-lg font-medium">{item.title}</h5>
                  <div class="mt-4 flex gap-4">
                    <p class="flex items-center gap-2">
                      <DynamicIcon icon="BsArrowsFullscreen" className="w-5 h-5 text-primary" />
                      {item.sqfit} sq. ft.
                    </p>
                    <p class="flex items-center gap-2">
                      <DynamicIcon icon="LuBedSingle" className="w-5 h-5 text-primary" />
                      {item.bed} Bed
                    </p>
                    <p class="flex items-center gap-2">
                      <DynamicIcon icon="BiBath" className="w-5 h-5 text-primary" />
                      {item.bath} Bath
                    </p>
                  </div>
                </div>
              </a>
            ),
          )}
        </div>

        <div class="flex justify-center">
          <a class="btn btn-secondary mt-10 text-center flex justify-center w-fit" href="/">{listing.data.btn}</a>
        </div>
      </div>
    </section>
  )
}


