---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { MdKeyboardArrowDown } from "react-icons/md";
import { IoClose, IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}
const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings, site } = config;
const { pathname } = Astro.url;
---

<header class="w-full absolute z-50">
  <nav class="container flex items-center justify-between pt-8 w-full">
    <!-- Logo + Desktop Menu -->
    <div class="flex items-center">
      <Logo />
      <!-- Desktop Menu -->
      <ul class="hidden lg:flex items-center space-x-2 ml-16">
        {main.map((menu) => (
          <li class="relative group">
            {menu.hasChildren && menu.children?.length ? (
              <>
                <div class="inline-flex items-center border border-transparent rounded-full px-4 py-2 cursor-pointer transition-all duration-300 group-hover:border-border text-text-light whitespace-nowrap">
                  <span>{menu.name}</span>
                  <span class="ml-1 flex items-center transition-transform duration-300 group-hover:rotate-180">
                    <MdKeyboardArrowDown />
                  </span>
                </div>
                <!-- Mega Dropdown -->
                <div class="mega-dropdown">
                  <div class="flex gap-12">
                    {[0, 1, 2].map((col) => (
                      <div class="flex flex-col gap-[10px] leading-7">
                        {menu.children?.slice(col * 6, col * 6 + (col === 2 ? 5 : 6)).map((child) => (
                          <a href={child.url} class={`transition ${pathname === child.url ? "active" : ""}`}>
                            {child.name}
                          </a>
                        ))}
                      </div>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <a
                href={menu.url}
                class="inline-block border border-transparent rounded-full px-4 py-2 transition-all duration-300 hover:border-border text-text-light"
              >
                {menu.name}
              </a>
            )}
          </li>
        ))}
      </ul>
    </div>

    <!-- Mobile Hamburger & Search -->
    <div class="lg:hidden relative flex items-center gap-5">
      <!-- Hidden Checkbox for Peer -->
      <input id="nav-toggle" type="checkbox" class="hidden peer" />

      <!-- Hamburger / Close -->
       <label for="nav-toggle" class="cursor-pointer flex items-center z-50">
        <IoClose className="h-6 w-6 text-text-light hidden peer-checked:block" />
        <svg class="h-6 w-6 fill-current block peer-checked:hidden" viewBox="0 0 24 24">
          <path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </label>

      {settings.search && (
        <button class="inline-flex items-center justify-center rounded-full bg-light/20 p-2 text-xl text-light flex-shrink-0 cursor-pointer" aria-label="search" data-search-trigger>
          <IoSearch />
        </button>
      )}

      <!-- Mobile Menu -->
      <ul class="fixed  top-[64px] z-20 hidden w-full flex-col gap-2 bg-dark peer-checked:flex lg:hidden">
        {main.map((menu) => (
          <li class="px-4 py-2">
            <a
              href={menu.url}
              class="block text-sm text-text-light border border-transparent rounded-full transition-all duration-300 hover:border-border"
            >
              {menu.name}
            </a>
            {menu.hasChildren && menu.children?.length ? (
              <ul class="mt-1 flex flex-col gap-1 pl-4">
                {menu.children.map((child) => (
                  <li>
                    <a
                      href={child.url}
                      class="block text-sm text-text-light border border-transparent rounded-full transition-all duration-300 hover:border-border"
                    >
                      {child.name}
                    </a>
                  </li>
                ))}
              </ul>
            ) : null}
          </li>
        ))}

        <!-- Mobile Bottom Section -->
        <li class="flex flex-col gap-3 px-4 py-4 border-t border-border">
          <a href={`tel:${site.phone}`} class="text-sm text-text-light whitespace-nowrap cursor-pointer px-3 py-1 rounded-full border border-transparent hover:border-border transition-all duration-300">
            {site.phone}
          </a>
          {settings.search && (
            <button class="inline-flex items-center justify-center rounded-full bg-light/50 p-3 text-xl text-light w-12 h-12" aria-label="search" data-search-trigger>
              <IoSearch />
            </button>
          )}
          {navigation_button.enable && (
            <a class="btn btn-primary rounded-full w-fit" href={navigation_button.link} target={navigation_button.link.startsWith("http") ? "_blank" : "_self"} rel="noopener">
              {navigation_button.label}
            </a>
          )}
        </li>
      </ul>
    </div>

    <!-- Desktop Right Section -->
    <div class="hidden lg:flex items-center space-x-3 flex-nowrap">
      <a href={`tel:${site.phone}`} class="text-text-light whitespace-nowrap cursor-pointer px-4 py-2 rounded-full border border-transparent hover:border-border transition-all duration-300">
        {site.phone}
      </a>
      {settings.search && (
        <button class="inline-flex items-center justify-center rounded-full bg-light/20 p-3 text-2xl text-light flex-shrink-0 cursor-pointer" aria-label="search" data-search-trigger>
          <IoSearch />
        </button>
      )}
      {navigation_button.enable && (
        <a class="btn btn-primary rounded-full flex-shrink-0" href={navigation_button.link} target={navigation_button.link.startsWith("http") ? "_blank" : "_self"} rel="noopener">
          {navigation_button.label}
        </a>
      )}
    </div>
  </nav>
</header>
