---
import Logo from "@/components/Logo.astro";
import config from "@/config/config.json";
import menu from "@/config/menu.json";
import { MdKeyboardArrowDown } from "react-icons/md";
import { IoClose, IoSearch } from "react-icons/io5";

export interface ChildNavigationLink {
  name: string;
  url: string;
}

export interface NavigationLink {
  name: string;
  url: string;
  hasChildren?: boolean;
  children?: ChildNavigationLink[];
}
const { main }: { main: NavigationLink[] } = menu;
const { navigation_button, settings, site } = config;
const { pathname } = Astro.url;
---

<header class="site-header">
  <nav class="site-header__nav container">
    <!-- Logo + Desktop Menu -->
    <div class="flex items-center">
      <Logo />
      <!-- Desktop Menu -->
      <ul class="hidden lg:flex items-center space-x-2 ml-16">
        {
          main.map((menu) => (
            <li class="relative group">
              {menu.hasChildren && menu.children?.length ? (
                <>
                  <div class="inline-flex items-center border border-transparent rounded-full px-4 py-2 cursor-pointer transition-all duration-300 group-hover:border-border text-text-light whitespace-nowrap">
                    <span>{menu.name}</span>
                    <span class="ml-1 flex items-center transition-transform duration-300 group-hover:rotate-180">
                      <MdKeyboardArrowDown />
                    </span>
                  </div>
                  {/* Mega Dropdown */}
                  <div class="mega-dropdown">
                    <div class="flex gap-12">
                      {[0, 1, 2].map((col) => (
                        <div class="flex flex-col gap-[10px] leading-7">
                          {menu.children
                            ?.slice(col * 6, col * 6 + (col === 2 ? 5 : 6))
                            .map((child) => (
                              <a
                                href={child.url}
                                class={`transition ${pathname === child.url ? "active" : ""}`}
                              >
                                {child.name}
                              </a>
                            ))}
                        </div>
                      ))}
                    </div>
                  </div>
                </>
              ) : (
                <a
                  href={menu.url}
                  class="inline-block border border-transparent rounded-full px-4 py-2 transition-all duration-300 hover:border-border text-text-light"
                >
                  {menu.name}
                </a>
              )}
            </li>
          ))
        }
      </ul>
    </div>

    <!-- Mobile Hamburger & Search -->
    <div class="site-header__mobile-actions lg:hidden">
      <!-- Hidden Checkbox for Peer -->
      <input id="nav-toggle" type="checkbox" class="hidden peer" />

      {
        settings.search && (
          <button
            class="site-header__mobile-search"
            aria-label="search"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )
      }

      <!-- Hamburger / Close -->
      <label for="nav-toggle" class="site-header__menu-toggle">
        <IoClose className="site-header__close h-6 w-6 text-text-light" />
        <svg
          class="site-header__hamburger h-6 w-6 fill-current"
          viewBox="0 0 24 24"
        >
          <path
            d="M3 6h18M3 12h18M3 18h18"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"></path>
        </svg>
      </label>

      <!-- Mobile Menu -->
      <ul class="site-header__mobile-menu peer-checked:flex">
        {
          main.map((menu) => (
            <li class="px-4 py-2">
              <a
                href={menu.url}
                class="block text-sm text-text-light border border-transparent rounded-full transition-all duration-300 hover:border-border"
              >
                {menu.name}
              </a>
              {menu.hasChildren && menu.children?.length ? (
                <ul class="mt-1 flex flex-col gap-1 pl-4">
                  {menu.children.map((child) => (
                    <li>
                      <a
                        href={child.url}
                        class="block text-sm text-text-light border border-transparent rounded-full transition-all duration-300 hover:border-border"
                      >
                        {child.name}
                      </a>
                    </li>
                  ))}
                </ul>
              ) : null}
            </li>
          ))
        }

        <!-- Mobile Bottom Section -->
        <li class="flex flex-col gap-3 px-4 py-4 border-t border-border">
          <a
            href={`tel:${site.phone}`}
            class="text-sm text-text-light whitespace-nowrap cursor-pointer px-3 py-1 rounded-full border border-transparent hover:border-border transition-all duration-300"
          >
            {site.phone}
          </a>
          {
            settings.search && (
              <button
                class="inline-flex items-center justify-center rounded-full bg-light/50 p-3 text-xl text-light w-12 h-12"
                aria-label="search"
                data-search-trigger
              >
                <IoSearch />
              </button>
            )
          }
          {
            navigation_button.enable && (
              <a
                class="btn btn-primary rounded-full w-fit"
                href={navigation_button.link}
                target={
                  navigation_button.link.startsWith("http") ? "_blank" : "_self"
                }
                rel="noopener"
              >
                {navigation_button.label}
              </a>
            )
          }
        </li>
      </ul>
    </div>

    <!-- Desktop Right Section -->
    <div class="hidden lg:flex items-center space-x-3 flex-nowrap">
      <a
        href={`tel:${site.phone}`}
        class="text-text-light whitespace-nowrap cursor-pointer px-4 py-2 rounded-full border border-transparent hover:border-border transition-all duration-300"
      >
        {site.phone}
      </a>
      {
        settings.search && (
          <button
            class="inline-flex h-[50px] w-[50px] flex-shrink-0 cursor-pointer items-center justify-center rounded-full bg-light/20 p-0 text-2xl text-light"
            aria-label="search"
            data-search-trigger
          >
            <IoSearch />
          </button>
        )
      }
      {
        navigation_button.enable && (
          <a
            class="btn btn-primary rounded-full flex-shrink-0"
            href={navigation_button.link}
            target={
              navigation_button.link.startsWith("http") ? "_blank" : "_self"
            }
            rel="noopener"
          >
            {navigation_button.label}
          </a>
        )
      }
    </div>
  </nav>
</header>

<style>
  .site-header {
    position: absolute;
    z-index: 50;
    width: 100%;
  }

  .site-header__nav {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    padding-top: 32px;
  }

  .site-header__mobile-actions {
    position: relative;
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .site-header__mobile-search {
    display: inline-flex;
    width: 50px;
    height: 50px;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: white;
    background: rgba(255, 255, 255, 0.2);
    font-size: 24px;
    cursor: pointer;
    transition: background-color 180ms ease;
  }

  .site-header__mobile-search:hover {
    background: rgba(255, 255, 255, 0.3);
  }

  .site-header__menu-toggle {
    z-index: 50;
    display: flex;
    color: white;
    cursor: pointer;
  }

  .site-header__close {
    display: none;
  }

  .site-header__hamburger {
    display: block;
  }

  .site-header__mobile-menu {
    position: fixed;
    top: 74px;
    right: 20px;
    left: 20px;
    z-index: 20;
    display: none;
    max-height: calc(100dvh - 94px);
    flex-direction: column;
    gap: 8px;
    overflow-y: auto;
    padding: 18px 4px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 16px;
    background: #1f4938;
    box-shadow: 0 18px 60px rgba(4, 22, 16, 0.22);
  }

  #nav-toggle:checked ~ .site-header__menu-toggle .site-header__close {
    display: block;
  }

  #nav-toggle:checked ~ .site-header__menu-toggle .site-header__hamburger {
    display: none;
  }

  #nav-toggle:checked ~ .site-header__mobile-menu {
    display: flex;
  }

  @media (max-width: 1023px) {
    .site-header__nav.container {
      padding-right: 4px;
      padding-left: 4px;
      padding-top: 10px;
    }
  }

  @media (min-width: 1024px) {
    .site-header__mobile-actions {
      display: none;
    }
  }
</style>
