---
import Social from "@/components/Social.astro";
import menu from "@/config/menu.json";
import social from "@/config/social.json";
import { FaMapLocationDot } from "react-icons/fa6";

const footerData = menu.footer;
const socialData = social.main;
---

<footer class="site-footer">
  <div class="site-footer__inner" data-aos="fade-up" data-aos-duration="1000">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <a href="/" aria-label="HomeQuest home">
          <img src={footerData.logo} alt="HomeQuest" width="226" height="40" />
        </a>
        <div class="site-footer__contact">
          <a href="tel:+19073574333">{footerData.phone}</a>
          <a href="mailto:hello@homequest.com">{footerData.email}</a>
        </div>
        <Social source={socialData} className="site-footer__socials" />
      </div>

      <div class="site-footer__directories">
        {
          footerData.sections?.map((section) => (
            <section
              class:list={[
                "site-footer__directory",
                { "site-footer__directory--office": section.address },
              ]}
            >
              <h2>{section.title}</h2>
              {section.links && (
                <ul>
                  {section.links.map((link) => (
                    <li>
                      <a href={link.url}>{link.name}</a>
                    </li>
                  ))}
                </ul>
              )}
              {section.address && (
                <div class="site-footer__office">
                  <p>{section.address}</p>
                  {section.map && (
                    <a
                      href="https://www.google.com/maps"
                      target="_blank"
                      rel="noreferrer"
                    >
                      <FaMapLocationDot /> {section.map}
                    </a>
                  )}
                </div>
              )}
            </section>
          ))
        }
      </div>
    </div>

    <div class="site-footer__bottom">
      <p>
        © Homequest 2024 <span aria-hidden="true">•</span> All right reserved
      </p>
      <nav aria-label="Legal">
        {
          footerData.bottomLinks?.map((link, index) => (
            <>
              <a href={link.url}>{link.name}</a>
              {index < footerData.bottomLinks.length - 1 && (
                <span aria-hidden="true" />
              )}
            </>
          ))
        }
      </nav>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    min-height: 474px;
    padding: 80px 30px 28px;
    border-radius: 24px 24px 0 0;
    color: #0a0915;
    background: #fff;
  }

  .site-footer__inner {
    display: flex;
    width: min(100%, 1320px);
    min-height: 366px;
    margin-inline: auto;
    flex-direction: column;
    justify-content: space-between;
  }

  .site-footer__main {
    display: grid;
    grid-template-columns: minmax(340px, 1fr) minmax(620px, 1.42fr);
    gap: 80px;
  }

  .site-footer__brand > a {
    display: inline-flex;
  }

  .site-footer__brand > a img {
    width: 226px;
    height: 40px;
  }

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0;
    margin-top: 80px;
  }

  .site-footer__contact a {
    width: fit-content;
    color: #0a0915;
    font-size: 16px;
    line-height: 28.8px;
  }

  :global(.site-footer__socials) {
    display: flex;
    gap: 8px;
    margin-top: 40px;
  }

  :global(.site-footer__socials a) {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid #dedede;
    border-radius: 14px;
    color: #111;
    transition:
      border-color 180ms ease,
      background-color 180ms ease;
  }

  :global(.site-footer__socials a:hover) {
    border-color: #dbfb1e;
    background: #dbfb1e;
  }

  :global(.site-footer__socials svg) {
    width: 20px;
    height: 20px;
  }

  .site-footer__directories {
    display: grid;
    grid-template-columns: 0.8fr 0.8fr 1.2fr;
    gap: 54px;
  }

  .site-footer__directory h2 {
    margin: 0 0 24px;
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 28px;
  }

  .site-footer__directory ul {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .site-footer__directory li,
  .site-footer__directory a,
  .site-footer__office p {
    color: rgba(10, 9, 21, 0.62);
    font-size: 16px;
    line-height: 40px;
  }

  .site-footer__directory a {
    transition: color 180ms ease;
  }

  .site-footer__directory a:hover {
    color: #1f4938;
  }

  .site-footer__office p {
    margin: 0;
    line-height: 28px;
  }

  .site-footer__office a {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-top: 20px;
    color: #0a0915;
    line-height: 28px;
  }

  .site-footer__office a svg {
    color: #1f4938;
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 23px;
    border-top: 1px solid #e3e3e3;
  }

  .site-footer__bottom p {
    margin: 0;
    color: rgba(10, 9, 21, 0.5);
    font-size: 14px;
  }

  .site-footer__bottom p span {
    margin-inline: 12px;
  }

  .site-footer__bottom nav {
    display: flex;
    gap: 32px;
    align-items: center;
  }

  .site-footer__bottom nav > span {
    width: 1px;
    height: 8px;
    background: rgba(10, 9, 21, 0.35);
  }

  .site-footer__bottom a {
    color: #0a0915;
  }

  @media (max-width: 1023px) {
    .site-footer {
      min-height: 771px;
      padding: 80px 20px 24px;
      border-radius: 16px 16px 0 0;
    }

    .site-footer__inner {
      min-height: 667px;
    }

    .site-footer__main {
      display: block;
    }

    .site-footer__brand {
      text-align: center;
    }

    .site-footer__contact {
      align-items: center;
      margin-top: 34px;
    }

    :global(.site-footer__socials) {
      justify-content: center;
      margin-top: 28px;
    }

    .site-footer__directories {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 28px 24px;
      margin-top: 52px;
      text-align: left;
    }

    .site-footer__directory--office {
      grid-column: 1 / -1;
    }

    .site-footer__directory h2 {
      margin-bottom: 12px;
    }

    .site-footer__directory li,
    .site-footer__directory a,
    .site-footer__office p {
      font-size: 14px;
      line-height: 30px;
    }

    .site-footer__office a {
      margin-top: 8px;
    }

    .site-footer__bottom {
      align-items: center;
      flex-direction: column-reverse;
      gap: 14px;
      padding-top: 18px;
      text-align: center;
    }

    .site-footer__bottom nav {
      gap: 16px;
      font-size: 13px;
    }
  }
</style>
