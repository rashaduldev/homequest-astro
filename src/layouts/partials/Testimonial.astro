---
import { markdownify } from "@/lib/utils/textConverter";
import ImageMod from "@/components/ImageMod.astro";
import { FaArrowLeft, FaArrowRight } from "react-icons/fa";
import { MdKeyboardArrowRight } from "react-icons/md";
const { testimonial } = Astro.props;
interface TestimonialItem {
  name: string;
  designation: string;
  content: string;
  avatar: string;
  link: string;
}
const testimonials: TestimonialItem[] = testimonial.data.testimonials;
---

{testimonial.data.enable && (
      <section class="row rounded-t-3xl">
        <div class="mb-12 flex flex-col lg:flex-row items-center justify-between mt-20 container lg:px-7">
          <h2 set:html={markdownify(testimonial.data.title)} class="mb-4 lg:text-5xl lg:leading-15 lg:tracking-[-2.5px]" />
          <a class="flex items-center gap-2 hover:text-text-dark/60" href="/">{testimonial.data.link} <span class="text-xl"><MdKeyboardArrowRight /></span></a>
        </div>
        <div class="relative">
          <div class="swiper testimonial-slider">
            <div class="swiper-wrapper">
              {testimonials.map((item: TestimonialItem, idx: number) => (
                <div
                  class="swiper-slide mt-20"
                  style={`transform: translateY(${idx % 2 === 0 ? "0px" : "-40px"}); transition: transform 0.3s ease;`}
                >
                  <div class="rounded-3xl bg-light p-8">
                     <div class="text-text-dark">
                        <ImageMod
                          height={104}
                          width={104}
                          class="rounded-full"
                          src={item.avatar}
                          alt={item.name}
                          format="webp"
                        />
                      </div>
                    <blockquote
                      set:html={markdownify(item.content)}
                      class="mt-14 h-[180px] text-xl leading-9"
                    />
                    <div class="mt-12 flex items-center">
                     
                      <div class="ml-4">
                        <h3
                          set:text={item.name}
                          class="text-xl leading-9 font-primary"
                        />
                        <p set:text={item.designation} class="text-lg leading-8 text-text-dark" />
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {/* Navigation buttons */}
            <div class="flex justify-center gap-4 mt-6">
              <button class="testimonial-prev p-3 rounded-full cursor-pointer">
                <FaArrowLeft />
              </button>
              <button class="testimonial-next p-3 rounded-full cursor-pointer">
                <FaArrowRight />
              </button>
            </div>
          </div>
        </div>
      </section>
)}

<script>
  import { Swiper } from "swiper";
  import "swiper/css";
  import { Autoplay, Navigation } from "swiper/modules";

  document.addEventListener("astro:page-load", () => {
    new Swiper(".testimonial-slider", {
      modules: [Navigation, Autoplay],
      spaceBetween: 40,
      loop: true,
      centeredSlides: true,
      autoplay: {
        delay: 2500,
        disableOnInteraction: false,
      },
      navigation: {
        nextEl: ".testimonial-next",
        prevEl: ".testimonial-prev",
      },
      breakpoints: {
        768: { slidesPerView: 2 },
        992: { slidesPerView: 3 },
      },
    });
  });
</script>
