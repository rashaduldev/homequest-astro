---
import { FaArrowUp } from "react-icons/fa6";
---

<section class="pt-20 px-[30px] pb-36 rounded-t-2xl bg-light -mt-10">
   <div class="container text-center">
      <h1 class="mb-16">Your trusted real estate partner</h1>
      <div class="flex flex-col md:flex-row gap-6">
         <div class="relative cursor-pointer">
            <img class="h-[562px] rounded-2xl" src="../../../public/images/property/buying.avif" alt="">
            <div class="text-text-dark absolute top-5 p-3 bg-light rounded-full right-5 rotate-45">
               <FaArrowUp />
            </div>
            <div class="px-6 py-7 bg-dark/90 absolute w-full bottom-0 text-text-light flex items-center gap-5 rounded-b-2xl">
               <img class="p-3 bg-light/50 rounded-full" src="../../../public/images/property/icon.svg" alt="">
            <div class="text-left"> 
               <h5>Property Buying</h5>
               <p class="text-text-light/50">Price starts from $5500</p>
            </div>
            </div>
         </div>
         <div>
            <img class="h-[562px]" src="../../../public/images/property/selling.avif" alt="">
         </div>
         <div>
            <img class="h-[562px]" src="../../../public/images/property/services.avif" alt="">
         </div>
      </div>
   </div>
</section>