---
export interface Props {
  entry: {
    cityLabel: string;
    stateLabel: string;
    serviceLabel: string;
    description: string;
    phone: string;
    priceFrom: number;
    heroImage: string;
  };
  pageTitle: string;
}

const { entry, pageTitle } = Astro.props;
---

<div class="shower-design bg-sky-50 rounded-lg p-8 border-l-4 border-sky-500">
  <h1 class="mb-2">{pageTitle}</h1>
  <p class="text-text-light mb-6">
    Serving {entry.cityLabel}, {entry.stateLabel}
  </p>

  <div class="row">
    <div class="lg:col-5">
      <img src={entry.heroImage} alt={pageTitle} class="rounded-lg mb-4" />
    </div>
    <div class="lg:col-7">
      <p class="mb-4">{entry.description}</p>
      <div class="flex items-center gap-4 mb-4">
        <span class="text-2xl font-bold">${entry.priceFrom}</span>
        <span class="text-text-light">/ day, all-inclusive</span>
      </div>
      <a href={`tel:${entry.phone}`} class="btn btn-outline-primary">
        Request a Quote — {entry.phone}
      </a>
    </div>
  </div>
</div>
