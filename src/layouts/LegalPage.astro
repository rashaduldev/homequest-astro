---
import type { LegalPageData } from "@/data/legal-pages";

interface Props {
  page: LegalPageData;
}

const { page } = Astro.props;
---

<article class="legal-page" style={`--legal-hero-height: ${page.heroHeight}px`}>
  <header class="legal-hero">
    <img
      src="/images/agent/details/hero.png"
      alt="Modern HomeQuest residence"
      fetchpriority="high"
    />
    <div class="legal-hero__shade"></div>
    <h1 data-aos="fade-up" data-aos-duration="900">{page.title}</h1>
  </header>

  <section class="legal-content" aria-label={`${page.title} content`}>
    <div class="legal-content__inner">
      {
        page.sections.map((section, index) => (
          <section
            class="legal-section"
            aria-labelledby={`${page.slug}-section-${index}`}
            data-aos="fade-up"
            data-aos-duration="900"
          >
            <h2 id={`${page.slug}-section-${index}`}>{section.heading}</h2>
            <div>
              {section.paragraphs.map((paragraph, paragraphIndex) => (
                <p
                  class:list={{
                    "legal-section__retention-lead":
                      section.heading === "Data Retention" &&
                      paragraphIndex === 0,
                  }}
                >
                  {paragraph}
                </p>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </section>

  <section class="legal-cta" aria-labelledby={`${page.slug}-cta-title`}>
    <img
      src="/images/company/cta.avif"
      alt="Modern property at dusk"
      loading="lazy"
    />
    <div class="legal-cta__shade"></div>
    <div class="legal-cta__content" data-aos="fade-up" data-aos-duration="1000">
      <h2 id={`${page.slug}-cta-title`}>
        <span>Ready to Make a</span>
        <span>Move? Contact Us Now!</span>
      </h2>
      <p>
        Contact us today to discuss your property needs and choose the right
        plan. We’re here to guide you through every step of the process.
      </p>
      <a href="/contact">Get Your Home</a>
    </div>
  </section>
</article>

<style>
  .legal-page {
    --hq-lime: #dbfb1e;
    color: #0a0915;
    background: #fff;
  }

  .legal-page h1,
  .legal-page h2,
  .legal-page p {
    margin: 0;
  }

  .legal-hero {
    position: relative;
    height: var(--legal-hero-height);
    overflow: hidden;
    color: #fff;
  }

  .legal-hero > img,
  .legal-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .legal-hero > img {
    object-fit: cover;
    object-position: center;
  }

  .legal-hero__shade {
    background: rgba(22, 54, 71, 0.2);
  }

  .legal-hero h1 {
    position: absolute;
    top: 205px;
    right: 30px;
    left: 30px;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 80px;
    font-weight: 400;
    line-height: 92px;
    letter-spacing: -3.5px;
    text-align: center;
  }

  .legal-content {
    padding: 112px 44px 152px;
  }

  .legal-content__inner {
    display: flex;
    width: min(779.5px, 100%);
    flex-direction: column;
    gap: 88px;
    margin-inline: auto;
  }

  .legal-section h2 {
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 44.8px;
    letter-spacing: -1.5px;
  }

  .legal-section > div {
    display: flex;
    flex-direction: column;
    gap: 20px;
    margin-top: 33px;
  }

  .legal-section p {
    color: #52525a;
    font-size: 16px;
    line-height: 28.8px;
    letter-spacing: -0.4px;
  }

  .legal-cta {
    position: relative;
    height: 624.609px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    color: #fff;
  }

  .legal-cta > img,
  .legal-cta__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .legal-cta > img {
    object-fit: cover;
    object-position: center;
  }

  .legal-cta__shade {
    background: linear-gradient(
      180deg,
      rgba(24, 55, 75, 0.46),
      rgba(9, 25, 33, 0.02)
    );
  }

  .legal-cta__content {
    position: relative;
    z-index: 1;
    width: min(748px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 88px;
    text-align: center;
  }

  .legal-cta h2 {
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 48px;
    font-weight: 400;
    line-height: 60px;
    letter-spacing: -2.5px;
  }

  .legal-cta h2 span {
    display: block;
  }

  .legal-cta__content > p {
    max-width: 598px;
    margin: 16px auto 32px;
    color: rgba(255, 255, 255, 0.8);
    font-size: 16px;
    line-height: 32.4px;
    letter-spacing: -0.2px;
  }

  .legal-cta__content > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: 32px;
    color: #050505;
    background: var(--hq-lime);
    font-size: 16px;
    font-weight: 500;
    line-height: 28.8px;
    transition:
      transform 180ms ease,
      filter 180ms ease;
  }

  .legal-cta__content > a:hover,
  .legal-cta__content > a:focus-visible {
    filter: brightness(0.95);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .legal-hero {
      height: 236px;
    }

    .legal-hero h1 {
      top: 100px;
      right: 20px;
      left: 20px;
      font-size: 40px;
      line-height: 46px;
      letter-spacing: -1px;
    }

    .legal-content {
      padding: 84px 44px;
    }

    .legal-content__inner {
      gap: 72px;
    }

    .legal-section__retention-lead {
      min-height: 172.782px;
    }

    .legal-cta {
      height: 506.422px;
      border-radius: 24px 24px 0 0;
    }

    .legal-cta__content {
      width: calc(100% - 40px);
      padding-top: 60px;
    }

    .legal-cta h2 {
      font-size: 36px;
      line-height: 45px;
      letter-spacing: -1.8px;
    }

    .legal-cta__content > p {
      margin-top: 16px;
      font-size: 16px;
      line-height: 32.4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .legal-page *,
    .legal-page *::before,
    .legal-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
