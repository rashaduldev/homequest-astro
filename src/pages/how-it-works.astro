      margin-top: 55px;
    }

    .process-step h2 {
      margin-top: 10px;
      font-size: 32px;
      line-height: 44.8px;
      letter-spacing: -0.8px;
    }

    .process-step__description {
      margin-top: 12px !important;
    }

    .process-step > img {
      left: 0;
      width: 100%;
      height: auto;
      aspect-ratio: 896 / 836;
      margin-top: 30px;
      border-radius: 16px;
    }

    .investment__image {
      height: 600px;
      border-radius: 16px 16px 0 0;
    }

    .investment__image img {
      object-position: 61% center;
    }

    .investment__panel {
      height: 1195px;
      padding: 70px 0 60px;
      border-radius: 16px 16px 0 0;
