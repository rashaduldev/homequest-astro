---
import Base from "@/layouts/Base.astro";

interface ProcessStep {
  number: string;
  eyebrow: string;
  title: string;
  description: string;
  image: string;
}

interface Statistic {
  value: number;
  suffix: string;
  label: string;
  description: string;
}

interface FaqItem {
  question: string;
  answer: string;
}

const steps: ProcessStep[] = [
  {
    number: "1",
    eyebrow: "How to start",
    title: "Tell Us What You Need",
    description:
      "Start by sharing your real estate goals with us. Whether you're buying, selling, or renting, we’ll gather all the necessary details to tailor our services to your needs. Simply fill out our contact form or give us a call.",
    image: "/images/how-it-works/tell-us.png",
  },
  {
    number: "2",
    eyebrow: "How to Book",
    title: "Personalized Property Solutions",
    description:
      "Our expert team will search for the perfect properties or buyers that match your criteria. We’ll arrange property viewings, market your listing, or connect you with tenants, handling all the details so you don’t have to.",
    image: "/images/how-it-works/solutions.png",
  },
  {
    number: "3",
    eyebrow: "Confirmed",
    title: "Close the Deal",
    description:
      "Once you’ve found the right match, we guide you through the final steps. From negotiating the best price to managing paperwork and legalities, we ensure a smooth and stress-free transaction.",
    image: "/images/how-it-works/close-deal.png",
  },
];

const statistics: Statistic[] = [
  {
    value: 5,
    suffix: ".0",
    label: "Client impressions",
    description:
      "Home value is determined by factors like location, property condition.",
  },
  {
    value: 88,
    suffix: "%",
    label: "Improved Business",
    description: "Health status is affected by factors like diet, lifestyle",
  },
  {
    value: 1,
    suffix: "M",
    label: "Successful Purchase",
    description: "Market value changes due to factors like demand, supply.",
  },
  {
    value: 12,
    suffix: "K",
    label: "Trusted by Clients",
    description:
      "Product quality varies based on factors like material, design.",
  },
];

const faqs: FaqItem[] = [
  {
    question: "How long does it take to buy or sell a property?",
    answer:
      "The time it takes to buy or sell a property depends on several factors, including market conditions, property type, and the buyer's/seller's readiness. On average, it takes 1 to 3 months from listing a property to closing a sale.",
  },
  {
    question: "What fees are involved in buying or selling a home?",
    answer:
      "AI image editor is a cutting-edge tool that harnesses the power of artificial intelligence to streamline and enhance the photo editing process.",
  },
  {
    question: "How is the value of my home determined?",
    answer:
      "One of the most popular in the remarkable features of AI image editors is their ability to enhance image quality.",
  },
  {
    question: "Can I get assistance with financing a property purchase?",
    answer:
      "For portrait photography, AI image editors excel at skin retouching, wrinkle reduction, and blemish removal.",
  },
  {
    question: "What are the benefits of hiring a property management service?",
    answer:
      "Product photography is another area where AI image editors shine. By accurately removing backgrounds and enhancing product details.",
  },
];
---

<Base
  title="How it Works"
  meta_title="How it Works | HomeQuest"
  description="See how HomeQuest helps you define your goals, find the right property solution, and close your real estate deal."
  image="/images/company/hero.avif"
>
  <div class="how-page">
    <section class="how-hero" aria-labelledby="how-page-title">
      <img
        src="/images/company/hero.avif"
        alt="Modern HomeQuest residence"
        fetchpriority="high"
      />
      <div class="how-hero__shade"></div>
      <h1 id="how-page-title" data-aos="fade-up" data-aos-duration="900">
        How it Works
      </h1>
    </section>

    <section class="process" aria-label="How HomeQuest works">
      <div class="process__inner">
        {
          steps.map((step, index) => (
            <article class="process-step">
              <div
                class="process-step__marker"
                data-aos="fade-up"
                data-aos-duration="900"
              >
                <span>{step.number}</span>
                {index < steps.length - 1 && <i aria-hidden="true" />}
              </div>
              <div
                class="process-step__copy"
                data-aos="fade-up"
                data-aos-delay="80"
                data-aos-duration="900"
              >
                <p class="process-step__eyebrow">{step.eyebrow}</p>
                <h2>{step.title}</h2>
                <p class="process-step__description">{step.description}</p>
              </div>
              <img
                src={step.image}
                alt=""
                width="896"
                height="836"
                loading={index === 0 ? "eager" : "lazy"}
                data-aos="fade-up"
                data-aos-delay="140"
                data-aos-duration="900"
              />
            </article>
          ))
        }
      </div>
    </section>

    <section class="investment" aria-labelledby="investment-title">
      <div
        class="investment__image"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <img
          src="/images/company/story-house.webp"
          alt="Contemporary HomeQuest property"
          loading="lazy"
        />
      </div>
      <div class="investment__panel">
        <div class="investment__intro page-container">
          <h2 id="investment-title">
            Don’t wait to buy real estate. Buy real estate and wait
          </h2>
          <p>
            Home value is determined by factors like location, property
            condition, recent sales of similar homes, and current market trends.
          </p>
        </div>
        <div class="statistics page-container">
          {
            statistics.map((item) => (
              <article class="statistic">
                <p class="statistic__number">
                  <span data-how-counter={item.value}>0</span>
                  {item.suffix}
                </p>
                <h3>{item.label}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="how-faq" aria-labelledby="how-faq-title">
      <div class="faq-inner" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="how-faq-title">Hear from Our Happy Homeowners</h2>
        <div class="faq-list">
          {
            faqs.map((item, index) => (
              <article class:list={["faq-item", { "is-open": index === 0 }]}>
                <button
                  class="faq-trigger"
                  type="button"
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <span>{item.question}</span>
                  <span class="faq-chevron" aria-hidden="true">
                    ›
                  </span>
                </button>
                <div class="faq-answer">
                  <div>
                    <p>{item.answer}</p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="how-cta" aria-labelledby="how-cta-title">
      <img
        src="/images/company/cta.avif"
        alt="Modern property at dusk"
        loading="lazy"
      />
      <div class="how-cta__shade"></div>
      <div class="how-cta__content" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="how-cta-title">
          <span>Ready to Make a</span>
          <span>Move? Contact Us Now!</span>
        </h2>
        <p>
          Contact us today to discuss your property needs and choose the right
          plan. We’re here to guide you through every step of the process.
        </p>
        <a href="/contact">Get Your Home</a>
      </div>
    </section>
  </div>
</Base>

<script>
  const initializeHowItWorks = () => {
    const page = document.querySelector<HTMLElement>(".how-page");
    if (!page || page.dataset.initialized === "true") return;
    page.dataset.initialized = "true";

    const counters =
      document.querySelectorAll<HTMLElement>("[data-how-counter]");
    const counterObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          const target = Number(element.dataset.howCounter ?? 0);
          const start = performance.now();
          const duration = 900;
          const update = (time: number) => {
            const progress = Math.min((time - start) / duration, 1);
            element.textContent = String(
              Math.round(target * (1 - Math.pow(1 - progress, 3))),
            );
            if (progress < 1) requestAnimationFrame(update);
          };
          requestAnimationFrame(update);
          observer.unobserve(element);
        });
      },
      { threshold: 0.45 },
    );
    counters.forEach((counter) => counterObserver.observe(counter));

    document
      .querySelectorAll<HTMLButtonElement>(".how-page .faq-trigger")
      .forEach((trigger) => {
        trigger.addEventListener("click", () => {
          const current = trigger.closest<HTMLElement>(".faq-item");
          document
            .querySelectorAll<HTMLElement>(".how-page .faq-item")
            .forEach((item) => {
              const shouldOpen =
                item === current && !item.classList.contains("is-open");
              item.classList.toggle("is-open", shouldOpen);
              item
                .querySelector<HTMLButtonElement>(".faq-trigger")
                ?.setAttribute("aria-expanded", String(shouldOpen));
            });
        });
      });
  };

  document.addEventListener("astro:page-load", initializeHowItWorks);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initializeHowItWorks, {
      once: true,
    });
  } else {
    initializeHowItWorks();
  }
</script>

<style>
