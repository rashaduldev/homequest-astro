    align-self: center;
  }

  .process-step__eyebrow {
    color: rgba(10, 9, 21, 0.7);
    font-size: 16px;
    line-height: 28.8px;
    letter-spacing: -0.2px;
  }

  .process-step h2 {
    margin-top: 10px;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 32px;
    font-weight: 400;
    line-height: 44.8px;
    letter-spacing: -0.8px;
  }

  .process-step__description {
    margin-top: 16px !important;
    color: rgba(10, 9, 21, 0.58);
    font-size: 16px;
    line-height: 28.8px;
    letter-spacing: -0.4px;
  }

  .process-step > img {
    position: relative;
    left: 48px;
    width: 408.36px;
    height: 381px;
    object-fit: cover;
    border-radius: 24px;
  }

  .investment__image {
    height: 880px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
  }

  .investment__image img {
