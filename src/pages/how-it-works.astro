    --hq-green: #1f4938;
    --hq-lime: #dbfb1e;
    --hq-warm: #f7f6f4;
    color: #0a0915;
    background: #fff;
  }

  .how-page h1,
  .how-page h2,
  .how-page h3,
  .how-page p {
    margin: 0;
  }

  .page-container {
    width: min(100% - 60px, 1320px);
    margin-inline: auto;
  }

  .how-hero {
    position: relative;
    height: 453px;
    overflow: hidden;
    color: #fff;
  }

  .how-hero > img,
  .how-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .how-hero > img {
    object-fit: cover;
    object-position: center;
  }

  .how-hero__shade {
    background: linear-gradient(
      180deg,
      rgba(12, 42, 56, 0.2),
      rgba(15, 35, 45, 0.26)
