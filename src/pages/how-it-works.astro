      font-size: 14px;
      line-height: 25.2px;
    }

    .how-faq {
      height: 912.844px;
      min-height: 0;
      padding: 70px 0 80px;
      overflow: hidden;
    }

    .faq-inner {
      width: calc(100% - 40px);
    }

    .faq-inner > h2 {
      text-align: left;
    }

    .faq-list {
      margin-top: 54px;
    }

    .faq-trigger {
