    font-weight: 400;
    line-height: 92px;
    letter-spacing: -3.5px;
    text-align: center;
  }

  .process {
    padding: 190px 30px 120px;
    background: #fff;
  }

  .process__inner {
    width: min(996px, 100%);
    margin-inline: auto;
  }

  .process-step {
    display: grid;
    grid-template-columns: 52px 423.64px 408.36px;
    gap: 0 32px;
    align-items: center;
    min-height: 381px;
  }

