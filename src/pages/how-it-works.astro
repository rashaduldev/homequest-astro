      font-size: 15px;
      line-height: 1.55;
    }

    .how-cta {
      height: 506.422px;
      border-radius: 16px 16px 0 0;
    }

    .how-cta__content {
      width: calc(100% - 40px);
      padding-top: 60px;
    }

    .how-cta h2 {
      font-size: 36px;
      line-height: 45px;
      letter-spacing: -1.8px;
    }

    .how-cta__content p {
      margin-top: 20px;
      font-size: 14px;
      line-height: 25.2px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .how-page *,
    .how-page *::before,
    .how-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
