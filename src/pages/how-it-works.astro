    margin-top: 76px;
  }

  .faq-item + .faq-item {
    margin-top: 4px;
  }

  .faq-trigger {
    display: flex;
    width: 100%;
    min-height: 64px;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 16px;
    border-radius: 14px;
    background: var(--hq-warm);
