<Base
  title="Our Story"
  meta_title="Our Story | HomeQuest"
  description="HomeQuest has been turning real estate dreams into reality and sharing homes since 1997."
  image="/images/company/hero.avif"
>
  <div class="company-page">
    <section class="company-hero" aria-labelledby="company-page-title">
      <img
        src="/images/company/hero.avif"
        alt="Modern HomeQuest residence"
        fetchpriority="high"
      />
      <div class="company-hero__shade"></div>
      <h1 id="company-page-title" data-aos="fade-up" data-aos-duration="1000">
        Our Story
      </h1>
    </section>

    <section class="story section-shell">
      <div
        class="story__inner page-container"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h2>
          Turning your real estate dreams into reality. Sharing homes since
          1997.
        </h2>
        <div class="story__copy">
          <p>
            Unique. Original. Remarkable. It’s difficult to develop real estate
            marketing ideas day in and day out that meet each of these criteria
            — especially when you spend much of your time on the road meeting
            with clients and leads.
          </p>
          <div class="story__principles">
            <div>
              <h3>Mission</h3>
              <p>
                Forget clunky application forms. We offer a modern,
                user-friendly platform that makes applying for a job a breeze.
              </p>
            </div>
            <div>
              <h3>Vision</h3>
              <p>
                Forget clunky application forms. We offer a modern,
                user-friendly platform that makes applying for a job a breeze.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="impact" aria-labelledby="impact-title">
      <div class="impact__image" data-aos="fade-up" data-aos-duration="1000">
        <img
          src="/images/company/story-house.webp"
          alt="Contemporary HomeQuest property"
          loading="lazy"
        />
      </div>
      <div
        class="impact__panel section-shell"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <div class="impact__intro page-container">
          <h2 id="impact-title">
            Don’t wait to buy real estate. Buy real estate and wait
          </h2>
          <p>
            Home value is determined by factors like location, property
            condition, recent sales of similar homes, and current market trends.
          </p>
        </div>
        <div class="stats page-container">
          {
            statistics.map((item) => (
              <article class="stat">
                <p class="stat__number">
                  <span data-counter={item.value}>0</span>
                  {item.suffix}
                </p>
                <h3>{item.label}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="benefits" aria-labelledby="benefits-title">
      <img
        class="benefits__image"
        src="/images/company/benefits.webp"
        alt="Family exploring their new home"
        loading="lazy"
      />
      <div class="benefits__card" data-aos="fade-up" data-aos-duration="1000">
        <div class="benefits__header">
          <h2 id="benefits-title">Turning your real estate dreams true!</h2>
          <p>
            Have questions or ready to take the next step? Whether you’re
            buying, selling, or just exploring options.
          </p>
          <a class="outline-button" href="/contact"
            >Get a Quote <span aria-hidden="true">→</span></a
          >
        </div>
        <div class="feature-list">
          {
            features.map((feature, index) => (
              <article class:list={["feature", { "is-open": index === 0 }]}>
                <button
                  type="button"
                  class="feature__trigger"
                  aria-expanded={index === 0 ? "true" : "false"}
                >
                  <span>{feature.number}</span>
                  <strong>{feature.title}</strong>
                </button>
                <div class="feature__body">
                  <p>{feature.description}</p>
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="values section-shell" aria-labelledby="values-title">
      <div class="page-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="values-title">Your Trusted Real Estate Partner</h2>
        <div class="values__grid">
          {
            values.map((item) => (
              <article class="value-card">
                <img
                  src={item.image}
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                />
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="quote-section section-shell" aria-labelledby="quote-title">
      <div
        class="quote-section__inner page-container"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <div class="quote-section__content">
          <h2 id="quote-title">Let’s Find Your<br />Perfect Property</h2>
          <p>
            Have questions or ready to take the next step? Whether you’re
            buying, selling, or just exploring options.
          </p>
          <div class="quote-section__contacts">
            <div>
              <span>Email Address</span>
              <a href="mailto:support@homequest.com">support@homequest.com</a>
            </div>
            <div>
              <span>Phone Call</span>
              <a href="tel:+0291801920">+0291801920,</a>
              <a href="tel:+982771882">+982771882</a>
            </div>
          </div>
        </div>
        <form class="quote-form" aria-label="Property quote request">
          <label>
            <span>Your name</span>
            <input
              type="text"
              name="name"
              placeholder="First and last name"
              autocomplete="name"
              required
            />
          </label>
          <label>
            <span>What do you want?</span>
            <select name="property" aria-label="What do you want?">
              <option>Buy a house</option>
              <option>Modern 3-Bedroom</option>
              <option>Luxury 4-Bedroom</option>
              <option>Luxury 2-Bedroom</option>
              <option>Chic 1-Bedroom</option>
            </select>
          </label>
          <label>
            <span>Your preferred location</span>
            <select name="location" aria-label="Your preferred location">
              <option>New York</option>
              <option>Amsterdam</option>
              <option>Barcelona</option>
            </select>
          </label>
          <label>
            <span>Your desired budget</span>
            <input
              type="text"
              name="budget"
              value="$900,000"
              inputmode="numeric"
            />
          </label>
          <label>
            <span>Your email address</span>
            <input
              type="email"
              name="email"
              placeholder="yourmail@homequest.com"
              autocomplete="email"
              required
            />
          </label>
          <label>
            <span>Your phone number</span>
            <input
              type="tel"
              name="phone"
              placeholder="+021 9029 9202"
              autocomplete="tel"
            />
          </label>
          <button type="submit">Get a Quote</button>
          <p class="quote-form__status" role="status" aria-live="polite"></p>
        </form>
      </div>
    </section>

    <section
      class="testimonials section-shell"
      aria-labelledby="testimonials-title"
      data-aos="fade-up"
      data-aos-duration="1000"
    >
      <div class="testimonials__heading page-container">
        <h2 id="testimonials-title">Your Trusted Real Estate Partner</h2>
        <a href="/reviews">Read all stories <span aria-hidden="true">›</span></a
        >
      </div>
      <div class="testimonial-window">
        <div class="testimonial-track" data-testimonial-track>
          {
            testimonials.map((item) => (
              <article class="testimonial-card">
                <img
                  src={item.image}
                  alt={item.name}
                  width="104"
                  height="104"
                  loading="lazy"
                />
                <blockquote>“{item.quote}”</blockquote>
                <h3>{item.name}</h3>
                <p>{item.role}</p>
              </article>
            ))
          }
        </div>
      </div>
      <div class="testimonial-controls">
        <button
          type="button"
          data-testimonial-prev
          aria-label="Previous testimonial">←</button
        >
        <button
          type="button"
          data-testimonial-next
          aria-label="Next testimonial">→</button
        >
      </div>
    </section>

    <section class="team section-shell" aria-labelledby="team-title">
      <div class="page-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="team-title">Your Trusted Real Estate Partner</h2>
        <div class="team__grid">
          {
            team.map((person) => (
              <article class="team-card">
                <div class="team-card__photo">
                  <img src={person.image} alt={person.name} loading="lazy" />
                  <a
                    href="https://www.threads.net/"
                    target="_blank"
                    rel="noreferrer"
                    aria-label={`${person.name} on Threads`}
                  >
                    <img
                      src="/images/company/threads.svg"
                      alt=""
                      width="24"
                      height="24"
                    />
                  </a>
                </div>
                <div class="team-card__body">
                  <h3>{person.name}</h3>
                  <p>{person.role}</p>
                </div>
              </article>
            ))
          }
        </div>
        <p class="brands__label">Trusted by International Leading Company</p>
        <div class="brands" aria-label="Trusted brands">
          {
            brands.map((brand, index) => (
              <img
                src={brand}
                alt={`Partner brand ${index + 1}`}
                loading="lazy"
              />
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="company-cta section-shell"
      aria-labelledby="company-cta-title"
    >
      <img
        src="/images/company/cta.avif"
        alt="Modern property at dusk"
        loading="lazy"
      />
      <div class="company-cta__shade"></div>
      <div
        class="company-cta__content"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h2 id="company-cta-title">
          Ready to Make a<br />Move? Contact Us Now!
        </h2>
        <p>
          Contact us today to discuss your property needs and choose the right
          plan. We’re here to guide you through every step of the process.
        </p>
        <a href="/contact">Get Your Home</a>
      </div>
    </section>
  </div>
</Base>

<script>
  const initializeCompanyPage = () => {
    const counters = document.querySelectorAll<HTMLElement>("[data-counter]");
    const counterObserver = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const element = entry.target as HTMLElement;
          const target = Number(element.dataset.counter ?? 0);
          const start = performance.now();
          const duration = 900;
          const update = (time: number) => {
            const progress = Math.min((time - start) / duration, 1);
            element.textContent = String(
              Math.round(target * (1 - Math.pow(1 - progress, 3))),
            );
            if (progress < 1) requestAnimationFrame(update);
          };
          requestAnimationFrame(update);
          observer.unobserve(element);
        });
      },
      { threshold: 0.45 },
    );
    counters.forEach((counter) => counterObserver.observe(counter));

    document
      .querySelectorAll<HTMLButtonElement>(".feature__trigger")
      .forEach((button) => {
        button.addEventListener("click", () => {
          const current = button.closest<HTMLElement>(".feature");
          document
            .querySelectorAll<HTMLElement>(".feature")
            .forEach((feature) => {
              const open =
                feature === current && !feature.classList.contains("is-open");
              feature.classList.toggle("is-open", open);
              feature
                .querySelector<HTMLButtonElement>(".feature__trigger")
                ?.setAttribute("aria-expanded", String(open));
            });
        });
      });

    const track = document.querySelector<HTMLElement>(
      "[data-testimonial-track]",
    );
    const previous = document.querySelector<HTMLButtonElement>(
      "[data-testimonial-prev]",
    );
    const next = document.querySelector<HTMLButtonElement>(
      "[data-testimonial-next]",
    );
    let activeIndex = 0;
    const moveTestimonials = (direction: number) => {
      if (!track) return;
      const cards = track.querySelectorAll<HTMLElement>(".testimonial-card");
      if (!cards.length) return;
      activeIndex = (activeIndex + direction + cards.length) % cards.length;
      const firstCard = cards[0];
      const gap =
        Number.parseFloat(
          getComputedStyle(track).columnGap || getComputedStyle(track).gap,
        ) || 24;
      track.style.transform = `translateX(-${activeIndex * (firstCard.offsetWidth + gap)}px)`;
    };
    previous?.addEventListener("click", () => moveTestimonials(-1));
    next?.addEventListener("click", () => moveTestimonials(1));

    const quoteForm = document.querySelector<HTMLFormElement>(".quote-form");
    quoteForm?.addEventListener("submit", (event) => {
      event.preventDefault();
      const status = quoteForm.querySelector<HTMLElement>(
        ".quote-form__status",
      );
      if (status)
        status.textContent = "Thanks — your request is ready for our team.";
    });
  };

  document.addEventListener("astro:page-load", initializeCompanyPage);
</script>

<style>
  .company-page {
    --hq-green: #1f4938;
    --hq-lime: #dbfb1e;
    --hq-warm: #f7f6f4;
    color: #050505;
    background: #fff;
  }

  .page-container {
    width: min(100% - 60px, 1320px);
    margin-inline: auto;
  }

  .section-shell {
    position: relative;
    border-radius: 24px 24px 0 0;
  }

  .company-page h1,
  .company-page h2,
  .company-page h3,
  .company-page p {
    margin: 0;
  }

  .company-page h2 {
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 48px;
    font-weight: 400;
    line-height: 1.25;
    letter-spacing: -2.5px;
  }

  .company-page p {
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    line-height: 1.75;
    letter-spacing: -0.2px;
  }

  .company-hero {
    position: relative;
    height: 453px;
    overflow: hidden;
    color: white;
  }

  .company-hero > img,
  .company-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .company-hero > img {
    object-fit: cover;
    object-position: center;
  }

  .company-hero__shade {
    background: linear-gradient(
      180deg,
      rgba(12, 42, 56, 0.2),
      rgba(15, 35, 45, 0.26)
    );
  }

  .company-hero h1 {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    padding-top: 28px;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 80px;
    font-weight: 400;
    line-height: 1;
    letter-spacing: -3.5px;
  }

  .story {
    z-index: 1;
    height: 730px;
    margin-top: 0;
    padding: 170px 0 93px;
    box-sizing: border-box;
    background: #fff;
  }

  .story__inner {
    display: flex;
    flex-direction: column;
    gap: 62px;
  }

  .story h2 {
    width: 783px;
    max-width: 100%;
    align-self: flex-start;
  }

  .story__copy {
    width: 794px;
    max-width: calc(100% - 333px);
    margin-left: 333px;
    padding-top: 0;
  }

  .story__copy > p {
    max-width: 794px;
    font-size: 20px;
    line-height: 36px;
    letter-spacing: -0.5px;
  }

  .story__principles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 54px;
    margin-top: 52px;
  }

  .story__principles h3,
  .value-card h3,
  .team-card h3,
  .testimonial-card h3 {
    margin-bottom: 14px;
    font-size: 20px;
    font-weight: 500;
    line-height: 1.35;
    letter-spacing: -0.35px;
  }

  .story__principles p,
  .value-card p {
    color: rgba(4, 4, 4, 0.58);
  }

  .impact__image {
    height: 880px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
  }

  .impact__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .impact__panel {
    min-height: 805px;
    margin-top: -1px;
    padding: 130px 0 85px;
    background: white;
  }

  .impact__intro {
    display: grid;
    grid-template-columns: 554px 1fr;
    gap: 120px;
    align-items: start;
  }

  .impact__intro h2 {
    max-width: 620px;
  }

  .impact__intro > p {
    max-width: 465px;
    padding-top: 16px;
    color: rgba(4, 4, 4, 0.62);
  }

  .stats {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 42px;
    margin-top: 104px;
  }

  .stat__number {
    color: var(--hq-green);
    font-family: var(--font-secondary), "Geist", sans-serif !important;
    font-size: 76px !important;
    line-height: 1 !important;
    letter-spacing: -4px !important;
  }

  .stat h3 {
    margin-top: 27px;
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    font-weight: 400;
  }

  .stat > p:last-child {
    margin-top: 82px;
    color: rgba(4, 4, 4, 0.48);
  }

  .benefits {
    position: relative;
    height: 913px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
  }

  .benefits__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .benefits__card {
    position: absolute;
    top: 72px;
    right: max(30px, calc((100vw - 1320px) / 2));
    display: flex;
    width: min(560px, calc(100% - 60px));
    min-height: 714px;
    flex-direction: column;
    justify-content: space-between;
    padding: 48px 40px 40px;
    border-radius: 16px;
    background: white;
  }

  .benefits__header > p {
    margin-top: 16px;
    color: rgba(4, 4, 4, 0.62);
  }

  .outline-button {
    display: inline-flex;
    align-items: center;
    gap: 16px;
    margin-top: 28px;
    padding: 10px 20px;
    border: 1px solid #dedede;
    border-radius: 999px;
    color: #050505;
    transition:
      background-color 180ms ease,
      border-color 180ms ease,
      transform 180ms ease;
  }

  .outline-button:hover {
    border-color: var(--hq-lime);
    background: var(--hq-lime);
    transform: translateY(-2px);
  }

  .feature {
    border-bottom: 1px solid #ddd;
  }

  .feature__trigger {
    display: grid;
    width: 100%;
    grid-template-columns: 48px 1fr;
    gap: 0;
    align-items: center;
    padding: 20px 0;
    text-align: left;
    cursor: pointer;
  }

  .feature__trigger span {
    color: rgba(4, 4, 4, 0.32);
  }

  .feature__trigger strong {
    font-size: 20px;
    font-weight: 500;
  }

  .feature__body {
    display: grid;
    grid-template-rows: 0fr;
    padding-left: 48px;
    transition:
      grid-template-rows 240ms ease,
      padding-bottom 240ms ease;
  }

  .feature__body p {
    min-height: 0;
    overflow: hidden;
    color: rgba(4, 4, 4, 0.58);
