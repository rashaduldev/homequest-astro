---

<Base title="HomeQuest">
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <img src="/images/banner.avif" alt="Modern HomeQuest residence" />
      <div class="home-hero__shade"></div>
      <div
        class="home-hero__content"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h1 id="home-hero-title">
          Turning Your Real Estate Dreams into Reality
        </h1>
        <p>
          Forget clunky application forms. We offer a modern, user-friendly
          platform that makes applying for a job a breeze.
        </p>
        <div class="home-search" data-search-trigger>
          <input
            type="text"
            placeholder="Search with a location"
            aria-label="Search with a location"
          /><button type="button">Search Home</button>
        </div>
      </div>
    </section>

    <section class="home-brands" aria-label="Trusted companies">
      <div data-aos="fade-up" data-aos-duration="1000">
        <p>Trusted by leading company</p><div class="home-brands__logos">
          {
            brands.map((brand, i) => (
              <img
                src={`/images/brand/${brand}.svg`}
                alt={`Trusted brand ${i + 1}`}
                loading="eager"
              />
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-listings" aria-labelledby="home-listings-title">
      <div class="home-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="home-listings-title">Exclusive properties by HomeQuest</h2>
        <div class="home-listings__grid">
          {
            properties.map(
              ([slug, title, price, area, bed, bath, image, tag]) => (
                <a class="home-listing-card" href={`/properties/${slug}`}>
                  <>
                    <div class="home-listing-card__image">
                      <>
                        <img
                          src={`/images/listing/${image}.avif`}
                          alt={title}
                          loading="eager"
                        />
                        <span>{tag}</span>
                      </>
                    </div>
                    <div class="home-listing-card__body">
                      <>
                        <p class="home-listing-card__price">{price}</p>
                        <h3>{title}</h3>
                        <div class="home-listing-card__facts">
                          <>
                            <span>
                              <BsArrowsFullscreen /> {area} sq. ft.
                            </span>
                            <span>
                              <LuBedSingle /> {bed} Bed
                            </span>
                            <span>
                              <BiBath /> {bath} Bath
                            </span>
                          </>
                        </div>
                      </>
                    </div>
                  </>
                </a>
              ),
            )
          }
        </div>
        <a class="home-button home-button--dark" href="/properties"
          >Explore All Listings</a
        >
      </div>
    </section>

    <section class="home-ceo" aria-labelledby="home-ceo-title">
      <div class="home-ceo__intro" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="home-ceo-title">A message from our CEO</h2><p>
          With years of experience in the real estate industry, we are dedicated
          to helping individuals and families discover the perfect property that
          aligns with their lifestyle and needs.
        </p>
      </div>
      <div class="home-ceo__media" data-aos="fade-up" data-aos-duration="1000">
        <video
          id="home-ceo-video"
          src="https://videos.pexels.com/video-files/6561920/6561920-uhd_2560_1440_25fps.mp4"
          poster="/images/ceo.avif"
          preload="auto"
          loop
          playsinline
          muted></video><img
          id="home-ceo-cover"
          src="/images/ceo.avif"
          alt="Sarah Thompson, HomeQuest CEO"
          loading="eager"
        /><div id="home-ceo-caption" class="home-ceo__caption">
          <div class="home-ceo__copy">
            <h3>Owning a home is a keystone of wealth...</h3><p>
              Sarah Thompson <span>•</span> CEO &amp; Founder
            </p>
          </div><button
            id="home-ceo-play"
            type="button"
            aria-label="Play CEO message"
            aria-pressed="false"
            ><span class="home-ceo__play-icon"><FaPlay /></span><span
              class="home-ceo__pause-icon"><FaPause /></span
            ></button
          >
        </div>
      </div>
    </section>

    <section class="home-benefits" aria-labelledby="home-benefits-title">
      <img
        src="/images/call-to-action.avif"
        alt="Happy family moving into a new home"
        loading="eager"
      /><div
        class="home-benefits__panel"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h2 id="home-benefits-title">
          Turning your real estate dreams true!
        </h2><p>
          Have questions or ready to take the next step? Whether you’re buying,
          selling, or just exploring options.
        </p><a href="/contact">Get a Quote</a><div class="home-benefits__list">
          {
            benefits.map(([title, description], i) => (
              <article class:list={["home-benefit", { "is-open": i === 0 }]}>
                <>
                  <button
                    type="button"
                    aria-expanded={i === 0 ? "true" : "false"}
                  >
                    <>
                      <span>{String(i + 1).padStart(2, "0")}</span>
                      <strong>{title}</strong>
                    </>
                  </button>
                  <div>
                    <p>{description}</p>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-services" aria-labelledby="home-services-title">
      <div class="home-container" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="home-services-title">Your trusted real estate partner</h2><div
          class="home-services__grid"
        >
          {
            services.map(([slug, title, price, image]) => (
              <a class="home-service-card" href={`/service/${slug}`}>
                <>
                  <img
                    src={`/images/property/${image}.avif`}
                    alt={title}
                    loading="eager"
                  />
                  <span class="home-service-card__arrow">
                    <FaArrowUp />
                    <FaArrowUp />
                  </span>
                  <div>
                    <>
                      <img src="/images/property/icon.svg" alt="" />
                      <span>
                        <>
                          <strong>{title}</strong>
                          <small>{price}</small>
                        </>
                      </span>
                    </>
                  </div>
                </>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <section
      class="home-testimonials"
      aria-labelledby="home-testimonials-title"
    >
      <div class="home-testimonials__heading">
        <h2 id="home-testimonials-title">Your Trusted Real Estate Partner</h2><a
          href="/reviews">Read all stories <MdKeyboardArrowRight /></a
        >
      </div><div class="home-testimonials__window">
        <div class="home-testimonials__track" data-home-testimonials-track>
          {
            testimonials.map(([name, role, image, quote]) => (
              <article class="home-testimonial-card">
                <>
                  <img
                    src={`/images/company/testimonial-${image}.avif`}
                    alt={name}
                    loading="eager"
                  />
                  <blockquote>“{quote}”</blockquote>
                  <h3>{name}</h3>
                  <p>{role}</p>
                </>
              </article>
            ))
          }
        </div>
      </div><div class="home-testimonials__controls">
        <button
          type="button"
          aria-label="Previous testimonial"
          data-home-testimonials-prev><FaArrowLeft /></button
        ><button
          type="button"
          aria-label="Next testimonial"
          data-home-testimonials-next><FaArrowRight /></button
        >
      </div>
    </section>

    <section class="home-contact" aria-labelledby="home-contact-title">
      <div class="home-contact__inner">
        <div
          class="home-contact__copy"
          data-aos="fade-up"
          data-aos-duration="1000"
        >
          <h2 id="home-contact-title">
            <span>Let’s Find Your</span><span>Perfect Property</span>
          </h2><p>
            Have questions or ready to take the next step? Whether you’re
            buying, selling, or just exploring options.
          </p><div class="home-contact__details">
            <div>
              <span>Email Address</span><a href="mailto:support@homequest.com"
                >support@homequest.com</a
              >
            </div><div>
              <span>Phone Call</span><a href="tel:+0291801920">+0291801920,</a
              ><a href="tel:+982771882">+982771882</a>
            </div>
          </div>
        </div>
        <form
          class="home-contact__form"
          data-aos="fade-up"
          data-aos-duration="1000"
        >
          <label
            >Your name<input
              type="text"
              name="name"
              placeholder="First and last name"
            /></label
          ><label
            >What do you want?<span
              ><select name="intent"
                ><option>Buy a house</option><option>Modern 3-Bedroom</option
                ><option>Luxury 4-Bedroom</option><option
                  >Luxury 2-Bedroom</option
                ><option>Chic 1-Bedroom</option></select
              ><MdKeyboardArrowDown /></span
            ></label
          ><label
            >Your preferred location<span
              ><select name="location"
                ><option>New York</option><option>Amsterdam</option><option
                  >Barcelona</option
                ></select
              ><MdKeyboardArrowDown /></span
            ></label
          ><label
            >Your desired budget<input
              type="number"
              name="budget"
              placeholder="$900,000"
            /></label
          ><label
            >Your email address<input
              type="email"
              name="email"
              placeholder="youremail@homequest.com"
            /></label
          ><label
            >Your phone number<input
              type="tel"
              name="phone"
              placeholder="+021 9029 9202"
            /></label
          ><button type="submit">Get a Quote</button>
        </form>
      </div>
    </section>

    <section class="home-faq" aria-labelledby="home-faq-title">
      <div class="home-faq__inner" data-aos="fade-up" data-aos-duration="1000">
        <h2 id="home-faq-title">Hear from Our Happy Homeowners</h2><div
          class="home-faq__list"
        >
          {
            faqs.map(([question, answer], i) => (
              <article class:list={["home-faq__item", { "is-open": i === 0 }]}>
                <>
                  <button
                    type="button"
                    aria-expanded={i === 0 ? "true" : "false"}
                  >
                    <>
                      <span>{question}</span>
                      <MdKeyboardArrowRight />
                    </>
                  </button>
                  <div>
                    <p>{answer}</p>
                  </div>
                </>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-final-cta" aria-labelledby="home-final-title">
      <img
        src="/images/getintouch.avif"
        alt="Modern property at dusk"
        loading="eager"
      /><div class="home-final-cta__shade"></div><div
        class="home-final-cta__content"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h2 id="home-final-title">
          <span>Ready to Make a</span><span>Move? Contact Us Now!</span>
        </h2><p>
          Contact us today to discuss your property needs and choose the right
          plan. We’re here to guide you through every step of the process.
        </p><a href="/contact">Get Your Home</a>
      </div>
    </section>
  </div>
</Base>

<script>
  const bindHomePage = () => {
    const page = document.querySelector<HTMLElement>(".home-page");
    if (!page || page.dataset.homeBound === "true") return;
    page.dataset.homeBound = "true";

    const play = document.querySelector<HTMLButtonElement>("#home-ceo-play");
    const video = document.querySelector<HTMLVideoElement>("#home-ceo-video");
    const cover = document.querySelector<HTMLElement>("#home-ceo-cover");
    const caption = document.querySelector<HTMLElement>("#home-ceo-caption");
    const copy = document.querySelector<HTMLElement>(".home-ceo__copy");
    const media = document.querySelector<HTMLElement>(".home-ceo__media");
    let playPending = false;

    const setPlayingState = (playing: boolean, loading = false) => {
      media?.classList.toggle("is-playing", playing);
      media?.classList.toggle("is-loading", loading);
      caption?.classList.toggle("is-playing", playing);
      copy?.setAttribute("aria-hidden", String(playing));
      play?.setAttribute(
        "aria-label",
        loading
          ? "Loading CEO message"
          : playing
            ? "Pause CEO message"
            : "Play CEO message",
      );
      play?.setAttribute("aria-pressed", String(playing));
      play?.setAttribute("aria-busy", String(loading));
    };

    const recoverVideo = () => {
      playPending = false;
      video?.pause();
      setPlayingState(false);
    };

    play?.addEventListener("click", async () => {
      if (!video || !cover || !caption || playPending) return;

      if (!video.paused) {
        video.pause();
        return;
      }

      playPending = true;
      setPlayingState(false, true);

      try {
        await video.play();
      } catch {
        recoverVideo();
      } finally {
        playPending = false;
        if (!video.paused) setPlayingState(true);
      }
    });
    video?.addEventListener("playing", () => {
      playPending = false;
      setPlayingState(true);
    });
    video?.addEventListener("pause", () => setPlayingState(false));
    video?.addEventListener("error", recoverVideo);
    video?.addEventListener("emptied", recoverVideo);
    setPlayingState(false);
    document.querySelectorAll<HTMLElement>(".home-benefit").forEach((item) =>
      item.querySelector("button")?.addEventListener("click", () =>
        document
          .querySelectorAll<HTMLElement>(".home-benefit")
          .forEach((other) => {
            const open = other === item && !other.classList.contains("is-open");
            other.classList.toggle("is-open", open);
            other
              .querySelector("button")
              ?.setAttribute("aria-expanded", String(open));
          }),
      ),
    );
    document.querySelectorAll<HTMLElement>(".home-faq__item").forEach((item) =>
      item.querySelector("button")?.addEventListener("click", () => {
        const open = !item.classList.contains("is-open");
        document
          .querySelectorAll<HTMLElement>(".home-faq__item")
          .forEach((other) => {
            other.classList.toggle("is-open", other === item && open);
            other
              .querySelector("button")
              ?.setAttribute("aria-expanded", String(other === item && open));
          });
      }),
    );
    const track = document.querySelector<HTMLElement>(
      "[data-home-testimonials-track]",
    );
    const cards = Array.from(
      document.querySelectorAll<HTMLElement>(".home-testimonial-card"),
    );
    let current = 0;
    const update = () => {
      if (!track || !cards[0]) return;
      const mobile = matchMedia("(max-width: 767px)").matches;
      const width = cards[0].getBoundingClientRect().width;
      const leading = mobile ? 20 : (innerWidth - 1499) / 2;
      track.style.transform = `translateX(${leading - current * (width + (mobile ? 20 : 24))}px)`;
    };
    document
      .querySelector("[data-home-testimonials-prev]")
      ?.addEventListener("click", () => {
        current = (current - 1 + cards.length) % cards.length;
        update();
      });
    document
      .querySelector("[data-home-testimonials-next]")
      ?.addEventListener("click", () => {
        current = (current + 1) % cards.length;
        update();
      });
    addEventListener("resize", update, { passive: true });
    update();
    document
      .querySelector<HTMLFormElement>(".home-contact__form")
      ?.addEventListener("submit", (event) => event.preventDefault());
  };
  document.addEventListener("astro:page-load", bindHomePage);
  bindHomePage();
</script>

<style>
