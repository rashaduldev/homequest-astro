---
import Base from "@/layouts/Base.astro";
import { markdownify } from "@/lib/utils/textConverter";
import CallToAction from "@/partials/CallToAction.astro";
import Listing from "@/partials/Listing.astro";
import PropertySection from "@/partials/PropertySection.astro";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";
import Testimonial from "@/partials/Testimonial.astro";
import { FaPlay } from "react-icons/fa6";
import ContactSection from "@/partials/ContactSection.astro";
import ImageMod from "@/components/ImageMod.astro";
import Banner from "@/partials/Banner.astro";


const homepage = (await getEntry("homepage","-index")) as CollectionEntry<"homepage">;
const testimonial = (await getEntry("testimonialSection","testimonial")) as CollectionEntry<"testimonialSection">;
const listing = (await getEntry("listingSection","listing")) as CollectionEntry<"listingSection">;
const call_to_action = (await getEntry("ctaSection","call-to-action")) as CollectionEntry<"ctaSection">;
const property = (await getEntry("propertySection","property-cards")) as CollectionEntry<"propertySection">;
const faq_section = (await getEntry("faq_section","faq-section")) as CollectionEntry<"faq_section">;
const contactsection = (await getEntry("contactSection","contact")) as CollectionEntry<"contactSection">;
const { brands_logo, getintouch, ceoinfo } = homepage.data;
---
<Base>
  <Banner />
  <!-- Company Brands Logo -->
   <section class="section-sm bg-primary rounded-t-3xl z-50 relative -mt-10">
        <div
          data-aos="fade-up"
          data-aos-duration="1000"
          class="container flex flex-col xl:flex-row items-center justify-between"
        >
          {brands_logo?.title && (
            <p class="text-text-dark text-xl text-center mb-10 xl:mb-0">
              {brands_logo?.title}
            </p>
          )}
          {brands_logo?.logos.length > 0 && (
            <div class="flex flex-row items-center justify-center gap-6 md:gap-10">
              {brands_logo?.logos.map((img, i) => (
                  <ImageMod
                    src={img}
                    height={48}
                    width={142}
                    alt={`Brand ${i + 1}`}
                    class="w-full rounded"
                    loading="lazy"
                    format="webp"
                  />
              ))}
            </div>
          )}
        </div>
   </section>
  <!-- Listing Section -->
  <Listing listing={listing} />
  <!-- Author info -->
  <section data-aos="fade-up" data-aos-duration="1000" class="section-sm pb-28">
    <div class="container relative w-full max-w-4xl mx-auto text-center">
      <h1 class="leading-15 mb-4">{ceoinfo?.title}</h1>
      <p class="leading-7 max-w-[755px] mx-auto text-text/80">
        {ceoinfo?.description}
      </p>
      <div class="relative mt-14 max-w-[1100px] mx-auto">
        <!-- Video -->
        <video
          id="ceoVideo"
          src={ceoinfo?.vediolink ?? ""}
          class="w-full rounded-3xl"
          playsinline
          muted
          style="display: none;"></video>

        <!-- Cover Image & Overlay -->
        <div id="ceoCoverWrapper" class="relative w-full">
          <img
            id="ceoCover"
            src={ceoinfo?.img}
            alt="CEO Cover"
            class="w-full rounded-3xl object-cover"
          />

          <div
            class="absolute bottom-10 text-light bg-opacity-50 rounded-lg flex items-center justify-between w-full px-10"
          >
            <div class="text-left">
              <h5 class="mb-2">{ceoinfo?.heading}</h5>
              <div
                class="flex items-center text-lg md:leading-8 text-text-light/60 gap-4"
              >
                <p class="">{ceoinfo?.ceoname ?? "CEO Name"}</p>
                <li class="">{ceoinfo?.designation ?? "CEO"}</li>
              </div>
            </div>
            <button
              id="playButton"
              class="mt-4 w-20 h-20 flex items-center justify-center bg-light rounded-xl text-dark text-3xl hover:scale-110 transition-transform shadow-lg cursor-pointer"
            >
              <FaPlay />
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>
  <!-- Call To Action -->
  <CallToAction call_to_action={call_to_action} />
  <!-- Property Section -->
  <PropertySection property={property} />
  <!-- Testimonials -->
  <Testimonial testimonial={testimonial} />
  <ContactSection contactsection={contactsection} />
  <!-- <FAQSection faq_section={faq_section} /> -->
  <!--  -->
  <section
    class="relative section pt-40 pb-52 bg-no-repeat bg-center bg-cover bg-gradient rounded-t-3xl"
    style={`background-image: url('${getintouch?.img}');`}>
    <div
      data-aos="fade-up"
      data-aos-duration="1000"
      class="container text-center"
    >
      <h1
        set:html={markdownify(getintouch?.title ?? "")}
        class="mb-[10px] text-text-light md:col-6 col-12 mx-auto leading-15"
      />
      <p
        set:html={markdownify(getintouch?.description ?? "")}
        class="col-12 md:col-6 text-lg mx-auto mb-10 leading-8 text-text-light/70"
      />
      <a class="btn btn-primary rounded-full" href="/">{getintouch?.btn}</a>
    </div>
    <div class="h-5 bg-light absolute w-full bottom-0 rounded-t-3xl"></div>
  </section>
</Base>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    const playButton = document.getElementById("playButton");
    const video = document.getElementById(
      "ceoVideo",
    ) as HTMLVideoElement | null;
    const coverWrapper = document.getElementById("ceoCoverWrapper");

    if (playButton && video && coverWrapper) {
      playButton.addEventListener("click", () => {
        coverWrapper.style.display = "none";
        video.style.display = "block";
        video.play().catch((err) => console.error("Video play error:", err));
      });
    }
  });
</script>
