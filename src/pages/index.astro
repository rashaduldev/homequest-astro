    "Elegant 3-Bedroom Penthouse in Hong Kong Island",
    "$1,405,000",
    "2,800",
    5,
    2,
    "elegant-3",
    "For Sale",
  ],
  [
    "stylish-2-bedroom-apartment-in-paris-france",
    "Stylish 2-Bedroom Apartment in Paris, France",
    "$1,405,000",
    "3,000",
