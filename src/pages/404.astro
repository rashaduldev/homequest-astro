---
import Base from "@/layouts/Base.astro";
import { MdArrowForward } from "react-icons/md";
---

<Base
  title="404 Error"
  meta_title="404 Error | HomeQuest"
  description="The page you are looking for does not exist. Return to the HomeQuest homepage."
  image="/images/company/hero.avif"
>
  <div class="error-page">
    <section class="error-hero" aria-labelledby="error-page-title">
      <img
        src="/images/company/hero.avif"
        alt="Modern HomeQuest residence"
        fetchpriority="high"
      />
      <div class="error-hero__shade"></div>
      <h1 id="error-page-title" data-aos="fade-up" data-aos-duration="900">
        404 Error!
      </h1>
    </section>

    <section class="error-section" aria-labelledby="error-message-title">
      <div class="error-content">
        <img
          class="error-content__image"
          src="/images/404-error.png"
          alt="Page not found illustration"
          data-aos="fade-up"
          data-aos-duration="900"
        />
        <div
          class="error-content__copy"
          data-aos="fade-up"
          data-aos-delay="100"
          data-aos-duration="900"
        >
          <h2 id="error-message-title">
            <span>Oops! Page Not</span>
            <span>Found</span>
          </h2>
          <p>
            It looks like the page you’re looking for doesn’t exist. Don’t
            worry, we’ll help you get back on track!
          </p>
          <a href="/">
            <span>Go back to Homepage</span>
            <MdArrowForward aria-hidden="true" />
          </a>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .error-page {
    --hq-green: #203f30;
    color: #0a0915;
    background: #fff;
  }

  .error-page h1,
  .error-page h2,
  .error-page p {
    margin: 0;
  }

  .error-hero {
    position: relative;
    height: 473px;
    overflow: hidden;
    color: #fff;
  }

  .error-hero > img,
  .error-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .error-hero > img {
    object-fit: cover;
    object-position: center;
  }

  .error-hero__shade {
    background: linear-gradient(
      180deg,
      rgba(12, 42, 56, 0.2),
      rgba(15, 35, 45, 0.26)
    );
  }

  .error-hero h1 {
    position: absolute;
    top: 205px;
    right: 30px;
    left: 30px;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 80px;
    font-weight: 400;
    line-height: 92px;
    letter-spacing: -3.5px;
    text-align: center;
  }

  .error-section {
    position: relative;
    z-index: 1;
    height: 467px;
    padding-top: 80px;
    border-radius: 24px 24px 0 0;
    background: #fff;
  }

  .error-content {
    display: grid;
    width: min(880px, calc(100% - 60px));
    height: 387px;
    grid-template-columns: 387px minmax(0, 1fr);
    gap: 70.4px;
    align-items: center;
    margin-inline: auto;
  }

  .error-content__image {
    display: block;
    width: 387px;
    height: 387px;
    object-fit: contain;
  }

  .error-content__copy {
    min-width: 0;
  }

  .error-content__copy h2 {
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 48px;
    font-weight: 400;
    line-height: 62.4px;
    letter-spacing: -2.5px;
  }

  .error-content__copy h2 span {
    display: block;
  }

  .error-content__copy p {
    margin-top: 25px;
    color: rgba(10, 9, 21, 0.64);
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    line-height: 28.8px;
    letter-spacing: -0.2px;
  }

  .error-content__copy a {
    display: inline-flex;
    width: 247px;
    align-items: center;
    gap: 12px;
    margin-top: 34px;
    padding: 10px 24px;
    border-radius: 12px;
    color: #fff;
    background: var(--hq-green);
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    font-weight: 600;
    line-height: 28.8px;
    letter-spacing: -0.6px;
    white-space: nowrap;
    transition:
      transform 180ms ease,
      background-color 180ms ease;
  }

  .error-content__copy a:hover {
    background: #162e23;
    transform: translateY(-2px);
  }

  .error-content__copy a :global(svg) {
    width: 20px;
    height: 20px;
    flex: 0 0 20px;
  }

  @media (max-width: 767px) {
    .error-hero {
      height: 236px;
    }

    .error-hero h1 {
      top: 100px;
      right: 20px;
      left: 20px;
      font-size: 40px;
      line-height: 46px;
      letter-spacing: -1.5px;
    }

    .error-section {
      height: 665px;
      padding: 20px 20px 0;
    }

    .error-content {
      width: 100%;
      height: auto;
      grid-template-columns: 1fr;
      gap: 45px;
    }

    .error-content__image {
      width: 100%;
      height: auto;
      aspect-ratio: 1;
    }

    .error-content__copy {
      text-align: center;
    }

    .error-content__copy h2 {
      font-size: 36px;
      line-height: 46.8px;
      letter-spacing: -1.8px;
    }

    .error-content__copy p {
      margin-top: 16px;
    }

    .error-content__copy a {
      margin-top: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .error-page *,
    .error-page *::before,
    .error-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
