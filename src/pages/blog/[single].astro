---
import { blogPosts, type BlogPostSummary } from "@/data/blog-posts";
import Base from "@/layouts/Base.astro";
import BlogDetail from "@/layouts/BlogDetail.astro";

export function getStaticPaths() {
  return blogPosts.map((post) => ({
    params: { single: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props as { post: BlogPostSummary };
---

<Base
  title={post.title}
  meta_title={`${post.title} | HomeQuest`}
  description={`Read HomeQuest’s guide: ${post.title}. Explore practical real estate advice for buyers, sellers, renters, and property investors.`}
  image={post.image}
>
  <BlogDetail post={post} />
</Base>
