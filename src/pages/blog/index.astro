---
import { blogPosts } from "@/data/blog-posts";
import Base from "@/layouts/Base.astro";
---

<Base
  title="Blog"
  meta_title="Blog | HomeQuest"
  description="Explore expert HomeQuest insights about buying, selling, renting, and investing in real estate."
  image="/images/company/hero.avif"
>
  <div class="blog-page">
    <section class="blog-hero" aria-labelledby="blog-page-title">
      <img
        src="/images/company/hero.avif"
        alt="Modern HomeQuest residence"
        fetchpriority="high"
      />
      <div class="blog-hero__shade"></div>
      <h1 id="blog-page-title" data-aos="fade-up" data-aos-duration="900">
        Blog
      </h1>
    </section>

    <section class="blog-directory" aria-label="HomeQuest articles">
      <div class="blog-grid">
        {
          blogPosts.map((post, index) => (
            <a
              class="blog-card"
              href={`/blog/${post.slug}`}
              data-aos="fade-up"
              data-aos-delay={String((index % 3) * 80)}
              data-aos-duration="900"
            >
              <div class="blog-card__image">
                <img
                  src={post.image}
                  alt=""
                  width="848"
                  height="440"
                  loading={index < 3 ? "eager" : "lazy"}
                />
              </div>
              <div class="blog-card__content">
                <h2>{post.title}</h2>
                <div class="blog-card__meta">
                  <time>{post.date}</time>
                  <p>by {post.author}</p>
                </div>
              </div>
            </a>
          ))
        }
      </div>
    </section>

    <section class="blog-cta" aria-labelledby="blog-cta-title">
      <img
        src="/images/company/cta.avif"
        alt="Modern property at dusk"
        loading="lazy"
      />
      <div class="blog-cta__shade"></div>
      <div
        class="blog-cta__content"
        data-aos="fade-up"
        data-aos-duration="1000"
      >
        <h2 id="blog-cta-title">
          <span>Ready to Make a</span>
          <span>Move? Contact Us Now!</span>
        </h2>
        <p>
          Contact us today to discuss your property needs and choose the right
          plan. We’re here to guide you through every step of the process.
        </p>
        <a href="/contact">Get Your Home</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .blog-page {
    --hq-lime: #dbfb1e;
    --hq-warm: #f7f6f4;
    color: #0a0915;
    background: #fff;
  }

  .blog-page h1,
  .blog-page h2,
  .blog-page p {
    margin: 0;
  }

  .blog-hero {
    position: relative;
    height: 453px;
    overflow: hidden;
    color: #fff;
  }

  .blog-hero > img,
  .blog-hero__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blog-hero > img {
    object-fit: cover;
    object-position: center;
  }

  .blog-hero__shade {
    background: linear-gradient(
      180deg,
      rgba(12, 42, 56, 0.2),
      rgba(15, 35, 45, 0.26)
    );
  }

  .blog-hero h1 {
    position: absolute;
    top: 205px;
    right: 30px;
    left: 30px;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 80px;
    font-weight: 400;
    line-height: 92px;
    letter-spacing: -3.5px;
    text-align: center;
  }

  .blog-directory {
    position: relative;
    z-index: 1;
    padding: 80px 30px;
    border-radius: 24px 24px 0 0;
    background: #fff;
  }

  .blog-grid {
    display: grid;
    width: min(1168.641px, 100%);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    align-items: start;
    margin-inline: auto;
  }

  .blog-card {
    min-width: 0;
    overflow: hidden;
    border-radius: 16px;
    color: #0a0915;
    background: var(--hq-warm);
    transition:
      transform 300ms cubic-bezier(0.22, 1, 0.36, 1),
      box-shadow 300ms ease;
  }

  .blog-card__image {
    aspect-ratio: 848 / 440;
    overflow: hidden;
    border-radius: 10px 10px 0 0;
  }

  .blog-card__image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 550ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .blog-card__content {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 16px 16px;
  }

  .blog-card h2 {
    color: #0a0915;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 24px;
    font-weight: 500;
    line-height: 33.6px;
    letter-spacing: -1px;
  }

  .blog-card__meta {
    display: flex;
    min-height: 82.406px;
    flex-direction: column;
    justify-content: center;
    padding: 16px;
    border-radius: 10px;
    background: #fff;
  }

  .blog-card__meta time,
  .blog-card__meta p {
    font-size: 14px;
    line-height: 25.2px;
    letter-spacing: -0.2px;
  }

  .blog-card__meta time {
    color: #203f30;
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-weight: 500;
  }

  .blog-card__meta p {
    color: #52525a;
    font-family: var(--font-primary), "Inter", sans-serif;
  }

  .blog-card:hover,
  .blog-card:focus-visible {
    box-shadow: 0 18px 44px rgba(15, 44, 32, 0.12);
    transform: translateY(-4px);
  }

  .blog-card:hover .blog-card__image img,
  .blog-card:focus-visible .blog-card__image img {
    transform: scale(1.045);
  }

  .blog-cta {
    position: relative;
    height: 624.609px;
    overflow: hidden;
    border-radius: 24px 24px 0 0;
    color: #fff;
  }

  .blog-cta > img,
  .blog-cta__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .blog-cta > img {
    object-fit: cover;
    object-position: center;
  }

  .blog-cta__shade {
    background: linear-gradient(
      180deg,
      rgba(24, 55, 75, 0.46),
      rgba(9, 25, 33, 0.02)
    );
  }

  .blog-cta__content {
    position: relative;
    z-index: 1;
    width: min(748px, calc(100% - 40px));
    margin: 0 auto;
    padding-top: 88px;
    text-align: center;
  }

  .blog-cta h2 {
    font-family: var(--font-secondary), "Geist", sans-serif;
    font-size: 48px;
    font-weight: 400;
    line-height: 60px;
    letter-spacing: -2.5px;
  }

  .blog-cta h2 span {
    display: block;
  }

  .blog-cta__content p {
    max-width: 598px;
    margin: 16px auto 32px;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    line-height: 32.4px;
    letter-spacing: -0.2px;
  }

  .blog-cta__content a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 24px;
    border-radius: 32px;
    color: #050505;
    background: var(--hq-lime);
    font-family: var(--font-primary), "Inter", sans-serif;
    font-size: 16px;
    font-weight: 500;
    line-height: 28.8px;
    transition:
      transform 180ms ease,
      filter 180ms ease;
  }

  .blog-cta__content a:hover,
  .blog-cta__content a:focus-visible {
    filter: brightness(0.95);
    transform: translateY(-2px);
  }

  @media (max-width: 767px) {
    .blog-hero {
      height: 236px;
    }

    .blog-hero h1 {
      top: 150px;
      right: 20px;
      left: 20px;
      font-size: 40px;
      line-height: 46px;
      letter-spacing: -1px;
    }

    .blog-directory {
      padding: 110px 20px 80px;
      border-radius: 16px 16px 0 0;
    }

    .blog-grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .blog-cta {
      height: 506.422px;
      border-radius: 16px 16px 0 0;
    }

    .blog-cta__content {
      width: calc(100% - 40px);
      padding-top: 60px;
    }

    .blog-cta h2 {
      font-size: 36px;
      line-height: 45px;
      letter-spacing: -1.8px;
    }

    .blog-cta__content p {
      margin-top: 16px;
      font-size: 16px;
      line-height: 32.4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .blog-page *,
    .blog-page *::before,
    .blog-page *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
