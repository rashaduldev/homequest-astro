    price: "$1,405,000",
    area: "1,256",
    beds: 5,
    baths: 2,
    image: "/images/properties/phuket-villa.avif",
    slug: "seaside-4-bedroom-villa-in-phuket-thailand",
  },
  {
    title: "Modern 3-Bedroom Apartment in Gulshan, Dhaka",
    status: "For Rent",
    price: "$9,000/mo",
    area: "4,820",
    beds: 3,
    baths: 2,
    image: "/images/properties/gulshan-apartment.avif",
    slug: "modern-3-bedroom-apartment-in-gulshan-dhaka",
  },
  {
    title: "Cozy 1-Bedroom Apartment in Sydney CBD, Australia",
    status: "For Sale",
    price: "$1,405,000",
    area: "3,650",
    beds: 3,
    baths: 2,
    image: "/images/properties/sydney-apartment.avif",
    slug: "cozy-1-bedroom-apartment-in-sydney-cbd-australia",
  },
  {
    title: "Stylish 3-Bedroom Apartment in Central Hong Kong",
    status: "For Sale",
    price: "$1,405,000",
    area: "2,365",
    beds: 3,
    baths: 2,
    image: "/images/properties/central-hong-kong-apartment.avif",
