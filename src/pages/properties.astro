    area: "2,800",
    beds: 5,
    baths: 2,
    image: "/images/properties/hong-kong-penthouse.avif",
    slug: "elegant-3-bedroom-penthouse-in-hong-kong-island",
  },
  {
    title: "Stylish 2-Bedroom Apartment in Paris, France",
    status: "For Sale",
    price: "$1,405,000",
    area: "3,000",
    beds: 3,
    baths: 2,
